{
  "name": "gugu-guardians",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "구구성 수호대 — 초등 연산 학습 라인 디펜스",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5184 --strictPort",
    "test": "vitest run",
    "probe": "node tools/balance-probe.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && vitest run && node tools/balance-probe.mjs && node tools/asset-check.mjs && node tools/asset-check.mjs public/assets",
    "build:single": "node tools/build-single.mjs",
    "deploy:server": "wrangler deploy --config server/wrangler.jsonc",
    "check:assets": "node tools/asset-check.mjs && node tools/asset-check.mjs public/assets",
    "qa:launch": "node tools/qa-launch.mjs",
    "check:layout": "node tools/layout-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "^26.1.2",
    "puppeteer": "^25.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.115.0"
  }
}
